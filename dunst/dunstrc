[global]
    monitor = 0
    follow = mouse
    width = (280, 380)
    height = (0, 150)
    origin = top-right
    offset = (24, 56)
    notification_limit = 5
    gap_size = 8

    padding = 12
    horizontal_padding = 14
    frame_width = 2
    corner_radius = 10
    separator_height = 2
    separator_color = frame

    font = FiraCode Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    ellipsize = end
    ignore_newline = no
    show_age_threshold = 60

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    progress_bar = true
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    highlight = "#e5484d"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

    background = "#181825f0"
    foreground = "#cdd6f4"
    frame_color = "#e5484d"

[urgency_low]
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    frame_color = "#e5484d"
    timeout = 6

[urgency_critical]
    frame_color = "#f0b44c"
    highlight = "#f0b44c"
    timeout = 0
