#! /bin/sh

pgrep -x sxhkd >/dev/null || sxhkd &

#bspc monitor -d 一 二 三 四 五 六 七 八 九 十

bspc config border_width 2
bspc config window_gap 12

bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

# Colores (Catppuccin Mocha + acento rojo del fondo)
bspc config normal_border_color   "#313244"
bspc config active_border_color   "#45475a"
bspc config focused_border_color  "#e5484d"
bspc config presel_feedback_color "#f0b44c"

# Reglas de ventanas
bspc rule -a yad-calendar state=floating sticky=on
bspc rule -a Yad state=floating
bspc rule -a Pavucontrol state=floating rectangle=720x480+0+0 center=true

# Monitores: DP-4 (principal, 180 Hz) a la izquierda y HDMI-0 a su derecha
xrandr --output DP-4   --mode 1920x1080 --rate 180 --pos 0x0    --primary \
       --output HDMI-0 --mode 1920x1080 --rate 60  --pos 1920x0

# Escritorios: 一-五 en DP-4 y 六-十 en HDMI-0
# (el orden de -O hace que Super+1..5 vaya a DP-4 y Super+6..0 a HDMI-0)
bspc wm -O DP-4 HDMI-0
bspc monitor DP-4 -d 一 二 三 四 五
bspc monitor HDMI-0 -d 六 七 八 九 十

#Cosas

setxkbmap latam

#Polybar
$HOME/.config/polybar/launch.sh

#$HOME/polybar-collection/launch.sh

#Historial del portapapeles
pgrep -f 'bspwm/scripts/clipd.sh' >/dev/null || "$HOME/.config/bspwm/scripts/clipd.sh" &

#Notificaciones
pgrep -x dunst >/dev/null || dunst &

#Wallpaper
#feh --bg-fill Downloads/wall1.jpg
nitrogen --restore &

#Transparencias
pgrep -x picom >/dev/null || picom -b

#Cursor
xsetroot -cursor_name left_ptr &

# ~/.config/bspwm/bspwmrc
# Bloqueo automático tras 30 min de inactividad (y antes de suspender)
xset s 1800 1800
pgrep -x xss-lock >/dev/null || xss-lock --transfer-sleep-lock -- "$HOME/.config/bspwm/scripts/lock.sh" &
