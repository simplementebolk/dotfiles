configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    font: "FiraCode Nerd Font Medium 12";
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Ventanas";
    drun-display-format: "{name}";
}

/* ── Catppuccin Mocha ───────────────────────────── */
* {
    bg:       #181825f0;
    bg-alt:   #313244;
    surface:  #45475a;
    fg:       #cdd6f4;
    fg-dim:   #6c7086;
    accent:   #e5484d;
    pink:     #f0b44c;
    urgent:   #fab387;

    /* Variables del tema por defecto de Rofi (que es claro): se redefinen
       todas para que ninguna fila use sus colores */
    normal-background:            transparent;
    normal-foreground:            @fg;
    alternate-normal-background:  transparent;
    alternate-normal-foreground:  @fg;
    active-background:            transparent;
    active-foreground:            @pink;
    alternate-active-background:  transparent;
    alternate-active-foreground:  @pink;
    urgent-background:            transparent;
    urgent-foreground:            @urgent;
    alternate-urgent-background:  transparent;
    alternate-urgent-foreground:  @urgent;
    selected-normal-background:   @bg-alt;
    selected-normal-foreground:   @accent;
    selected-active-background:   @bg-alt;
    selected-active-foreground:   @accent;
    selected-urgent-background:   @urgent;
    selected-urgent-foreground:   #181825;
    border-color:                 @accent;
    separatorcolor:               transparent;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    background-color: @bg;
}

mainbox {
    padding: 18px;
    spacing: 14px;
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    border-radius: 10px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar…";
    placeholder-color: @fg-dim;
    cursor: text;
}

message {
    padding: 8px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @pink;
}

listview {
    border: 0;
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    text-color: @pink;
}

element selected.normal,
element selected.active {
    background-color: @bg-alt;
    text-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #1e1e2e;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
