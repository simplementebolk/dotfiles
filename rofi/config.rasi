configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    font: "FiraCode Nerd Font Medium 12";
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Ventanas";
    drun-display-format: "{name}";
}

/* ── Catppuccin Mocha ───────────────────────────── */
* {
    bg:       #1e1e2ef0;
    bg-alt:   #313244;
    surface:  #45475a;
    fg:       #cdd6f4;
    fg-dim:   #6c7086;
    accent:   #cba6f7;
    pink:     #f5c2e7;
    urgent:   #f38ba8;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    background-color: @bg;
}

mainbox {
    padding: 18px;
    spacing: 14px;
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    border-radius: 10px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar…";
    placeholder-color: @fg-dim;
    cursor: text;
}

message {
    padding: 8px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @pink;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    text-color: @pink;
}

element selected.normal,
element selected.active {
    background-color: @bg-alt;
    text-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #1e1e2e;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
